# 火山引擎 Coding Plan API 配置（Claude API 兼容格式）
# 方式一：通过环境变量（推荐，更安全，不写入文件）
#   export ANTHROPIC_AUTH_TOKEN=your_api_key
#   export ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
#   export ARK_MODEL=claude-3-5-sonnet-20241022

# 方式二：通过 .env 文件（以下变量名也可以）
# ARK_API_KEY=your_api_key_here
# ARK_MODEL=claude-3-5-sonnet-20241022
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# 服务配置
HOST=0.0.0.0
PORT=52764

# Database
DATABASE_URL=sqlite:///./stock_analyzer.db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Scheduler
SCHEDULER_ENABLED=true
DAILY_REPORT_CRON=30 15 * * 1-5
